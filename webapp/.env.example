# .env.local にコピーして使う（.env.local は Git に含めない）
# ローカル: `npx supabase start` の出力値 / 本番: Supabase ダッシュボード → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# サーバー専用の秘密鍵（退会・管理者によるユーザー削除で使用）。NEXT_PUBLIC_ を絶対に付けないこと
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
