{
  "expo": {
    "name": "こいまち",
    "slug": "koimachi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.koimachi",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "プロフィール写真と本人確認書類の選択に使用します",
        "NSCameraUsageDescription": "本人確認書類の撮影に使用します"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.koimachi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール写真と本人確認書類の選択に使用します",
          "cameraPermission": "本人確認書類の撮影に使用します"
        }
      ]
    ],
    "scheme": "koimachi"
  }
}
